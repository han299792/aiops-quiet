.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Raw telemetry is tens of MB per run and lives only on the machine that
# captured it. Small artifacts (manifest/verdict/cost/session) are committed.
runs/**/telemetry/
runs/**/raw_*.json

# API keys never enter the repo. The pod reads them from a Kubernetes
# Secret; .env is only a fallback for a pod that was already running when
# the secret was created and cannot be restarted without losing its kind
# cluster.
.env
*.env
!.env.example
